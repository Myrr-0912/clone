# Optional LLM chat backend. Leave DEEPSEEK_API_KEY empty to use local deterministic text chat.
# Set LLM_BACKEND=local to force deterministic local text chat even when an API key is present.
LLM_BACKEND=
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800

# Optional text profile training. Empty/unset: uses DeepSeek/LLM when an API key
# exists, otherwise falls back to deterministic local extraction.
# local: force local extraction even when an API key is configured.
# llm / deepseek: force LLM analysis using the ex-skill-inspired
# Relationship Memory + 5-layer Persona schema.
TEXT_TRAINING_BACKEND=
TEXT_TRAINING_TIMEOUT_SECONDS=60
TEXT_TRAINING_TEMPERATURE=0.2
TEXT_TRAINING_MAX_TOKENS=2600

# Optional voice synthesis backend.
# Empty/unset: voice mode shows text fallback and reports that speech is not configured.
# mock: returns a short local WAV tone so the browser audio path can be verified.
# http / voxcpm-http / voxcpm: POSTs to VOICE_TTS_URL or VOXCPM_TTS_URL.
VOICE_TTS_BACKEND=
VOICE_TTS_URL=
VOXCPM_TTS_URL=
VOICE_TTS_API_KEY=
VOICE_TTS_TIMEOUT_SECONDS=60
# Optional advanced TTS controls forwarded to HTTP/VoxCPM backends.
# VOICE_TTS_CONTROL_PROMPT applies to all emotions unless a per-emotion override
# such as VOICE_TTS_CONTROL_PROMPT_WARM is set.
# Set VOICE_TTS_INCLUDE_REFERENCE_AUDIO=true for remote TTS/VoxCPM bridge services that cannot read local referenceAudioPath.
VOICE_TTS_CONTROL_PROMPT=
VOICE_TTS_CONTROL_PROMPT_NATURAL=
VOICE_TTS_CONTROL_PROMPT_CALM=
VOICE_TTS_CONTROL_PROMPT_WARM=
VOICE_TTS_CONTROL_PROMPT_HAPPY=
VOICE_TTS_CONTROL_PROMPT_EXCITED=
VOICE_TTS_CONTROL_PROMPT_SAD=
VOICE_TTS_CFG_VALUE=
VOICE_TTS_INFERENCE_STEPS=
VOICE_TTS_NORMALIZE=
VOICE_TTS_INCLUDE_REFERENCE_AUDIO=false
# Local VoxCPM bridge example:
# VOICE_TTS_BACKEND=voxcpm
# VOICE_TTS_URL=http://127.0.0.1:8810/speak

# Optional voice training backend.
# Empty/unset: uploaded samples are saved, but no training job starts.
# mock: marks the uploaded samples as a ready local verification model.
# http / voxcpm-http / voxcpm: POSTs sample paths to VOICE_TRAINING_URL or VOXCPM_TRAINING_URL.
# Set VOICE_TRAINING_INCLUDE_AUDIO=true for remote training/VoxCPM bridge services that cannot read local samplePaths.
# Optional async status polling: GET /api/clones/{id}/voice/status POSTs job metadata
# to VOICE_TRAINING_STATUS_URL or VOXCPM_TRAINING_STATUS_URL while status is queued/running.
VOICE_TRAINING_BACKEND=
VOICE_TRAINING_URL=
VOXCPM_TRAINING_URL=
VOICE_TRAINING_STATUS_URL=
VOXCPM_TRAINING_STATUS_URL=
VOICE_TRAINING_API_KEY=
VOICE_TRAINING_TIMEOUT_SECONDS=120
VOICE_TRAINING_STATUS_TIMEOUT_SECONDS=30
VOICE_TRAINING_INCLUDE_AUDIO=false
# Local VoxCPM bridge example:
# VOICE_TRAINING_BACKEND=voxcpm
# VOICE_TRAINING_URL=http://127.0.0.1:8810/train

# Optional standalone control page for the local VoxCPM bridge.
# Run scripts/run_voice_model_control.py and open http://127.0.0.1:8820.
VOXCPM_BRIDGE_PYTHON=
VOXCPM_BRIDGE_SCRIPT=
VOXCPM_BRIDGE_HOST=127.0.0.1
VOXCPM_BRIDGE_PORT=8810
VOXCPM_BRIDGE_DEVICE=auto
VOXCPM_MODEL_PATH=
VOXCPM_ZIPENHANCER_MODEL_PATH=
VOXCPM_BRIDGE_ENABLE_DENOISER=false
VOXCPM_BRIDGE_OPTIMIZE=false
VOXCPM_BRIDGE_LOG_PATH=logs/voxcpm-bridge.log
VOXCPM_BRIDGE_STATE_PATH=data/voice-model-control/voxcpm-bridge.json
VOXCPM_BRIDGE_HEALTH_TIMEOUT_SECONDS=1.5
VOXCPM_BRIDGE_STARTUP_TIMEOUT_SECONDS=12
